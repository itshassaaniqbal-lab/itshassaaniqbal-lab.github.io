import { StrictMode } from "react";
import { createRoot } from "react-dom/client";
import { InteractiveModel } from "./InteractiveModel.webgl";

const mountNode = document.getElementById("expertise-model-root");

if (!mountNode) {
  throw new Error("The expertise model mount point is missing.");
}

createRoot(mountNode).render(
  <StrictMode>
    <InteractiveModel />
  </StrictMode>,
);
